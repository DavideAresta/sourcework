# ---------------------------------------------------------------------------
# Which backend reaches the model.
#
#   litellm       hosted API via LiteLLM. Needs credentials.
#   llama-cpp     local llama.cpp llama-server or llama-swap. No LiteLLM proxy.
#   claude-code   the `claude` CLI in print mode. Uses its own stored login.
#   opencode-cli  `opencode run`. Uses OpenCode's own provider config.
#   copilot-cli   `copilot -p`. Uses `copilot login`.
#   codex-cli     `codex exec`. Uses `codex login` (or CODEX_HOME).
#   agy-cli       `agy --print` (Antigravity). Uses its own sign-in.
#
# The five CLI backends carry their own authentication, so no API key is
# plumbed through SourceWork at all - if you are signed into the CLI, the whole
# pipeline runs on that subscription. They are slower per call than an API
# (a process starts and loads its config each time), which is why they get a
# longer timeout below.
#
# Check what is usable on this machine:  sourcework backends
# ---------------------------------------------------------------------------
SOURCEWORK_LLM__BACKEND=litellm

# Try these, in order, when the active backend fails or hits a usage limit.
# Comma-separated. Empty = a failure is terminal.
# SOURCEWORK_LLM__FAILOVER_ORDER=claude-code,opencode-cli

# ---------------------------------------------------------------------------
# Models, per role. Roles let you spend where it matters:
#   reasoning  requirements analyst, PRD writer, critic
#   default    evidence extraction
#   vision     images
#   fast       (available, currently unused by the agents)
#
# Model ids are per backend and do NOT travel: `opencode-go/glm-5` means
# something to OpenCode and nothing to the claude CLI. Set them for every
# backend you route to, including failover targets. Anything left unset means
# "let that backend pick its own default".
# ---------------------------------------------------------------------------

# litellm - any LiteLLM-supported provider: anthropic/, openai/, azure/,
# bedrock/, vertex_ai/, ollama/, together_ai/, ...
SOURCEWORK_LLM__DEFAULT_MODEL=anthropic/claude-sonnet-4-5
SOURCEWORK_LLM__REASONING_MODEL=anthropic/claude-opus-4-6
SOURCEWORK_LLM__VISION_MODEL=anthropic/claude-sonnet-4-5
SOURCEWORK_LLM__FAST_MODEL=anthropic/claude-haiku-4-5
# The adversarial review. Worth pointing at a different *family* from the
# writer: a critic trained alongside it finds the same phrasing natural and
# confirms rather than challenges. Unset = use the reasoning model.
# SOURCEWORK_LLM__CRITIC_MODEL=anthropic/claude-opus-4-6

# claude-code - aliases (opus/sonnet/haiku) track the latest build of a tier.
# SOURCEWORK_LLM__CLAUDE_CODE_MODELS__DEFAULT=haiku
# SOURCEWORK_LLM__CLAUDE_CODE_MODELS__REASONING=sonnet
# SOURCEWORK_LLM__CLAUDE_CODE_MODELS__VISION=sonnet

# opencode-cli - `opencode models` lists what your providers offer.
# Required: OpenCode has no usable default, and omitting it fails the call
# with an unhelpful "Unexpected server error".
# SOURCEWORK_LLM__OPENCODE_MODELS__DEFAULT=opencode/claude-haiku-4-5
# SOURCEWORK_LLM__OPENCODE_MODELS__REASONING=opencode/claude-sonnet-4-5

# copilot-cli - `auto` lets Copilot choose.
# SOURCEWORK_LLM__COPILOT_MODELS__DEFAULT=auto

# codex-cli - unset lets Codex pick. Effort is the tier knob here, not the
# model: SOURCEWORK_LLM__EFFORT maps onto `-c model_reasoning_effort`.
# SOURCEWORK_LLM__CODEX_MODELS__DEFAULT=gpt-5.4-codex

# agy-cli - `agy models` lists what your sign-in offers. It fronts three model
# families at once, so the critic can be a different lineage from the writer
# without configuring a second backend. Most ids already encode their tier
# (-high/-medium/-low) and then EFFORT is left alone.
# SOURCEWORK_LLM__AGY_MODELS__DEFAULT=gemini-3.6-flash-medium
# SOURCEWORK_LLM__AGY_MODELS__CRITIC=claude-sonnet-4-6

SOURCEWORK_LLM__MAX_TOKENS=8192
SOURCEWORK_LLM__TEMPERATURE=0.2
SOURCEWORK_LLM__TIMEOUT_S=180
SOURCEWORK_LLM__CLI_TIMEOUT_S=600

# Reasoning effort, for backends that take one (low|medium|high|xhigh|max).
# Ignored by litellm.
# SOURCEWORK_LLM__EFFORT=medium

# Optional: route everything through a gateway (LiteLLM proxy, Portkey, ...)
# SOURCEWORK_LLM__API_BASE=https://llm-gateway.internal/v1
# SOURCEWORK_LLM__API_KEY=sk-...

# Ask the backend to *enforce* the JSON schema rather than just describe it.
# On a server that grammar-constrains decoding (llama.cpp, vLLM, Ollama) this
# makes malformed JSON impossible instead of unlikely, which is what lets a
# small local model drive the pipeline without spending MAX_RETRIES
# re-answering calls. Ignored by backends that cannot enforce a schema.
# SOURCEWORK_LLM__CONSTRAINED_JSON=1

# Retries LiteLLM makes inside one call. Lower it for a local server, where the
# usual failure is a timeout: 3 attempts at a 20-minute ceiling is an hour
# spent learning the same thing once.
# SOURCEWORK_LLM__LITELLM_RETRIES=2

# ---------------------------------------------------------------------------
# Local models: llama.cpp's OpenAI-compatible server (one model per process).
#
#   llama-server -m <model>.gguf --mmproj <mmproj>.gguf \
#       -c 32768 -ngl 99 --port 8081 --alias local --jinja -rea off
#
# `-rea off` matters: a hybrid reasoning model otherwise spends the whole
# output budget thinking and returns empty content. `--mmproj` is what makes
# the vision role work. Every role points at the same alias because one server
# process serves one model; put llama-swap in front to route roles separately.
#
# SOURCEWORK_LLM__BACKEND=litellm
# SOURCEWORK_LLM__API_BASE=http://127.0.0.1:8081/v1
# SOURCEWORK_LLM__API_KEY=local
# SOURCEWORK_LLM__DEFAULT_MODEL=openai/local     # the `openai/` prefix is what
# SOURCEWORK_LLM__REASONING_MODEL=openai/local   # points LiteLLM at API_BASE
# SOURCEWORK_LLM__VISION_MODEL=openai/local
# SOURCEWORK_LLM__FAST_MODEL=openai/local
# SOURCEWORK_LLM__TIMEOUT_S=1200                 # minutes per call, not seconds
# SOURCEWORK_LLM__ANALYSIS_BATCH_CHARS=24000     # prompt AND answer must fit 32k
# SOURCEWORK_LLM__ANALYSIS_BATCH_ITEMS=30

# Or select the dedicated local backend in Settings. It connects directly to
# llama-server, and the Settings page offers the models served by that endpoint.
# SOURCEWORK_LLM__BACKEND=llama-cpp
# SOURCEWORK_LLM__LLAMA_CPP_API_BASE=http://127.0.0.1:8081/v1
# SOURCEWORK_LLM__LLAMA_CPP_API_KEY=local
# SOURCEWORK_LLM__LLAMA_CPP_MODELS__DEFAULT=openai/local
# SOURCEWORK_LLM__LLAMA_CPP_MODELS__REASONING=openai/local
# SOURCEWORK_LLM__LLAMA_CPP_MODELS__VISION=openai/local
# Directories scanned by `scripts/llama-models.py` and llama-swap for GGUFs.
# Colon-separated; subdirectories are included.
# SOURCEWORK_MODEL_DIRS=/home/you/.lmstudio/models:/srv/models

# CLI backend tuning.
# Run OpenCode without external plugins: faster, and it stops OpenCode
# re-installing a plugin tree into the scratch dir on every call. Also
# disables your global OpenCode plugins, so validate before turning it on.
# SOURCEWORK_LLM__OPENCODE_PURE=1
#
# A dedicated COPILOT_HOME. The Copilot CLI keeps credentials, MCP config,
# plugins and skills in one directory; point this at a copy holding only the
# credentials and generation calls stop dialling your MCP servers.
# SOURCEWORK_LLM__COPILOT_HOME=/home/you/.copilot-sourcework
#
# The same for Codex. Note that an OPENAI_API_KEY in your environment is
# preferred by Codex over its stored login, so it would bill the API rather
# than your subscription - which is the opposite of the point of a CLI backend.
# SOURCEWORK_LLM__CODEX_HOME=/home/you/.codex-sourcework

# Provider credentials - only for the litellm backend.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=
# AZURE_API_VERSION=

# Set to 1 to run the whole system with a deterministic fake LLM (no network,
# no keys, no CLI). Used by the test suite and the local smoke test.
SOURCEWORK_LLM__STUB=0

# ---------------------------------------------------------------------------
# Confluence Cloud
# ---------------------------------------------------------------------------
# Unscoped API token  -> base_url = https://<site>.atlassian.net/wiki
# Scoped API token    -> base_url = https://api.atlassian.com/ex/confluence/<cloudId>/wiki
SOURCEWORK_CONFLUENCE__BASE_URL=https://your-site.atlassian.net/wiki
SOURCEWORK_CONFLUENCE__EMAIL=you@example.com
SOURCEWORK_CONFLUENCE__API_TOKEN=
SOURCEWORK_CONFLUENCE__DEFAULT_SPACE_KEY=PRD
# Optional: publish PRDs under this page id
# SOURCEWORK_CONFLUENCE__DEFAULT_PARENT_ID=

# ---------------------------------------------------------------------------
# A2A peer registry (used by the orchestrator). Base URLs only - the
# orchestrator resolves /.well-known/agent-card.json itself.
# ---------------------------------------------------------------------------
SOURCEWORK_PEERS__ORCHESTRATOR=http://localhost:8000
SOURCEWORK_PEERS__INGESTION=http://localhost:8001
SOURCEWORK_PEERS__VISION=http://localhost:8002
SOURCEWORK_PEERS__TRANSCRIPT=http://localhost:8003
SOURCEWORK_PEERS__CONFLUENCE=http://localhost:8004
SOURCEWORK_PEERS__REQUIREMENTS=http://localhost:8005
SOURCEWORK_PEERS__WRITER=http://localhost:8006
SOURCEWORK_PEERS__CRITIC=http://localhost:8007

# ---------------------------------------------------------------------------
# Inter-agent auth. Every agent declares an apiKey security scheme on its card
# and rejects calls without this header. Rotate per environment.
# ---------------------------------------------------------------------------
# Turning ENFORCE on while leaving this key alone refuses to start: the default
# is published in this repository, so enforcing with it looks like authentication
# and stops nobody. Generate one:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
SOURCEWORK_SECURITY__API_KEY=dev-local-shared-secret
SOURCEWORK_SECURITY__HEADER=X-SourceWork-Key
SOURCEWORK_SECURITY__ENFORCE=0

# Let ingestion fetch loopback, link-local and private addresses. Off, because
# making the server issue a request is the whole of SSRF - 169.254.169.254 is
# cloud credentials. On only if your document store really is internal.
# SOURCEWORK_SECURITY__ALLOW_PRIVATE_FETCH=0

# Runs executing at once; the rest queue. A run is a queue of calls to one model
# server, not CPU work the OS can interleave: against a local single-GPU server,
# two runs wanting different models make it thrash and both finish later.
# SOURCEWORK_MAX_CONCURRENT_RUNS=2

# ---------------------------------------------------------------------------
# Requirements quality. The critic runs a deterministic rule pack (ISO/IEC/IEEE
# 29148 characteristics, INCOSE writing rules) before the model review. EARS
# also makes the analyst write requirements in EARS shapes (When..., While...,
# If...then..., Where..., or "The system shall...") and flags statements that
# take none of them. Off by default - conforming phrasing is a team choice.
# SOURCEWORK_QUALITY__EARS=0

# Delete finished runs (and their checkpoints) older than this many days, on UI
# start-up. 0 = keep everything. The run store holds full source text, so an
# installation with a retention policy needs a number here.
# SOURCEWORK_RUNS__RETENTION_DAYS=0

SOURCEWORK_LOG_LEVEL=INFO
